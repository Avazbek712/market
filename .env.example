POSTGRES_DB=minimarket
POSTGRES_USER=minimarket
POSTGRES_PASSWORD=change-me-strong-password

MINIO_ROOT_USER=minimarket
MINIO_ROOT_PASSWORD=change-me-strong-password
# Reused as the app's MinIO access/secret key (see docker-compose.prod.yml) — no separate IAM user yet
MINIO_BUCKET=minimarket-files

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generated-secret-min-32-bytes
JWT_EXPIRATION_MINUTES=30
